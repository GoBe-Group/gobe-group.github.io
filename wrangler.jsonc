{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gobe",
  "compatibility_date": "2026-07-27",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    // Unmatched paths get 404.html rather than Cloudflare's bare "not found".
    // That page also rescues the old pretty profile links (/u/ada), which have
    // no file behind them, by sending them to /u/?h=ada.
    "not_found_handling": "404-page"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
